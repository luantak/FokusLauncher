    <string name="settings_dot_search_url_template_dialog_title">Plantilla de búsqueda URL</string>
    <string name="settings_dot_search_url_template_help">Puedes usar un enlace de búsqueda HTTPS o un enlace profundo de aplicación (por ejemplo, intent://). Escribe %1$s donde deben ir las palabras de búsqueda—el lanzador las reemplaza por lo que escribes después de `. search` o `.x search`. Ejemplo: https://example.com/search?q=%1$s</string>
